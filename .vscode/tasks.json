{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run SUSHI only",
            "type": "shell",
            "command": "npx",
            "args": [
                "--no",
                "fsh-sushi",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
      "label": "Trigger auto build - main branch",
      "type": "shell",
      "command": "curl -X POST \"https://us-central1-fhir-org-starter-project.cloudfunctions.net/ig-commit-trigger\" -H \"Content-type: application/json\" --data '{\"ref\": \"refs/heads/main\", \"repository\": {\"full_name\": \"AuDigitalHealth/CC\"}}'"
        },
        {
            "label": "Run IG Publisher (after SUSHI)",
            "type": "shell",
            "command": "java",
            "args": [
                "-Xmx8g",
                "-Djava.awt.headless=true",
                "-jar",
                "input-cache/publisher.jar",
                "-ig",
                ".",
                "-no-sushi"
            ],
            "group": "build",
            "dependsOn": "Run SUSHI only",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Download latest IG Publisher",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "_updatePublisher.sh"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "type": "shell",
            "label": "Run _genonce.sh",
            "command": "export PATH=\"$(npm config get prefix)/bin:$(npm config get prefix):$PATH\" && bash _genonce.sh",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run auto-pub tool",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "npx publish"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        }
    ]
}